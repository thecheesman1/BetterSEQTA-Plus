[Unit]
Description=Ask SEQTA bridge (BetterSEQTA+) on :8737, public via cloudflared as ask-api.bin-chicken.org
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/ask-seqta
ExecStart=/usr/bin/env node --env-file-if-exists=.env server.mjs
Restart=on-failure
RestartSec=5
# Hardening: it only needs to read its own directory and talk to the network.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
