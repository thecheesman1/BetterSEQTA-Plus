# Copy to .env (never commit it). See README.md.

# cli = your own Claude subscription, this computer only (default)
# api = Anthropic API key (can be shared with OPEN=1)
BACKEND=cli
# Required for BACKEND=api
ANTHROPIC_API_KEY=
MODEL=claude-haiku-5-5
# low | medium | high
EFFORT=low

# 1 = anyone may ask without a key (API backend only), rate limited per IP
OPEN=0
PER_IP_PER_HOUR=20
# Callers with an access key from keys.json
PER_KEY_PER_HOUR=60
# Hard cap on all requests per day, protects the bill
DAILY_CAP=1000

PORT=8737
# cloudflared connects locally; never expose this port directly
HOST=127.0.0.1
